# ──────────────────────────────────────────────────────────────────────────────
# Comic backend — required environment variables (TEMPLATE ONLY, no real values)
# Copy to .env (git-ignored) for local dev, or configure in your secret manager
# (GitHub Actions secrets / Azure Key Vault / Container App env) for deployments.
# ──────────────────────────────────────────────────────────────────────────────

# ── MySQL (Azure Database for MySQL) ─────────────────────────────────────────
# NOTE: persistence.xml reads these as JVM system properties, so also pass them
# to Tomcat via JAVA_OPTS:
#   JAVA_OPTS="-DDB_URL=%DB_URL% -DDB_USER=%DB_USER% -DDB_PASSWORD=***"
DB_URL=jdbc:mysql://YOUR_SERVER.mysql.database.azure.com:3306/ComicDB?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_USER=your_db_user@YOUR_SERVER
DB_PASSWORD=your_d…word

# ── Gmail SMTP (account activation + password reset emails) ──────────────────
# Use a Gmail App Password, never the account password.
SMTP_USERNAME=your_account@gmail.com
SMTP_APP_PASSWORD=your_g…word

# ── Azure Blob Storage (EPUB files) ──────────────────────────────────────────
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=***
AZURE_BLOB_CONTAINER=temp

# ── CORS allow-list (comma-separated origins, no trailing slash) ─────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Public base URLs used in emails ──────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8080/Comic/api
