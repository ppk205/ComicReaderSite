# =============================================================================
# ComicReaderSite Backend — Environment Variables Template
# =============================================================================
# Copy this file to .env (or configure these as system environment variables
# before starting Tomcat). Never commit your actual .env file to version control.
# This .env.example file is safe to commit.
# =============================================================================

# ── MySQL Database ─────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://YOUR_MYSQL_HOST:3306/ComicDB?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Required for Azure mode. If not set, EpubServlet falls back to local disk storage.
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=temp

# ── Local Storage (Fallback / Offline Mode) ───────────────────────────────────
# Directory where EPUB files are stored when Azure is unavailable.
# Defaults to $CATALINA_HOME/epub-storage if not set.
EPUB_STORAGE_DIR=C:\path\to\epub-storage

# ── Gmail SMTP (for password reset & activation emails) ──────────────────────
SMTP_USERNAME=your.email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example for production: https://your-frontend.azurewebsites.net
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# HOW TO APPLY (Windows Tomcat):
#   Create or edit: %CATALINA_HOME%\bin\setenv.bat
#   Add one line per variable:
#     set DB_URL=jdbc:mysql://...
#     set DB_USER=ppk123
#     set DB_PASSWORD=xxxxxxxx
#     ... etc
#
# HOW TO APPLY (Linux/Mac Tomcat):
#   Create or edit: $CATALINA_HOME/bin/setenv.sh
#   Add one line per variable:
#     export DB_URL="jdbc:mysql://..."
#     ... etc
#
# NOTE on persistence.xml:
#   JPA reads DB credentials via Tomcat system properties.
#   Pass them as:
#     JAVA_OPTS="-DDB_URL=... -DDB_USER=... -DDB_PASSWORD=..."
#   in setenv.bat/setenv.sh
# =============================================================================
